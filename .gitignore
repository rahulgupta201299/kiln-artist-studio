# ─── Dependencies ─────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build output ─────────────────────
/.next/
/out/
/build
/dist

# ─── TypeScript ───────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing ──────────────────────────────────
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# ─── Environment variables (never commit secrets) ─
.env
.env*.local
.env.development
.env.production
.env.test
# keep a template so others know which vars exist
!.env.example

# ─── Deployment ───────────────────────────────
.vercel
.netlify
.turbo

# ─── Logs ─────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# ─── Caches ───────────────────────────────────
.cache
.eslintcache
.stylelintcache
.parcel-cache
.swc

# ─── OS files ─────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Editors / IDEs ───────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*.swo
*~
*.sublime-workspace

# ─── Misc ─────────────────────────────────────
*.pem
*.zip
